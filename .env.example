# Supabase Configuration
# Copia este archivo como .env y completa con tus credenciales de Supabase

VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Hugging Face Configuration (Opcional - para resúmenes de texto)
# Obtén tu API key gratuita en: https://huggingface.co/settings/tokens
# Si no se proporciona, se usará el servicio demo gratuito
VITE_HUGGINGFACE_API_KEY=your_huggingface_api_key_here